# Public base URL of the Clan Capes API. NEXT_PUBLIC_* is baked into the
# client bundle at build time, so Railway must set this as a service variable
# BEFORE deploy. Use the api service's public domain in production:
#   NEXT_PUBLIC_API_URL=https://api-<your-id>.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:3001
