# Server-side env for the single-service Next.js app.
# Copy to `.env.local` for local development.
#
# Auth — admin login.
JWT_SECRET=local-dev-secret-not-for-prod-32chars-min-ok-here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Optional bcrypt hash overrides ADMIN_PASSWORD when present:
# ADMIN_PASSWORD_HASH=$2a$12$replace-with-actual-hash

# Paper plugin REST endpoint.
MINECRAFT_API_URL=http://127.0.0.1:8080
MINECRAFT_API_TOKEN=change-me-same-as-paper-config-yml

# Public URL the Fabric mod / players will GET capes from.
# Locally: http://localhost:3000/api/static/capes
# Railway: https://<your-domain>/api/static/capes
CDN_PUBLIC_URL=http://localhost:3000/api/static/capes

# Where uploaded PNG files live on disk (Railway mounts a Volume here).
UPLOAD_DIR=./data/capes
AUDIT_LOG=./data/audit.log
MAX_UPLOAD_KB=256
