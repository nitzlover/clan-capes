{
  "schemaVersion": 1,
  "id": "clancapes",
  "version": "${version}",
  "name": "Crestoria",
  "description": "Renders Crestoria clan cosmetics (capes + armor trims) as native Minecraft layers (client-side).",
  "authors": ["Crestoria Team"],
  "contact": {
    "homepage": "https://github.com/clancapes/clan-capes",
    "sources": "https://github.com/clancapes/clan-capes"
  },
  "license": "MIT",
  "icon": "assets/clancapes/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.clancapes.ClanCapesClient"]
  },
  "mixins": ["clancapes.client.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "26.1",
    "java": ">=25",
    "fabric-api": "*"
  }
}
